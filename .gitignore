# --- WorldClimExtractR .gitignore ---

# Large climate data folders (TIFF files)
# Ignore all files inside climate_data recursively, but keep .gitkeep files to track directories
/climate_data/**/*
!/climate_data/**/
!/climate_data/**/.gitkeep

# Case studies
# Ignore all case studies except the clean template and main documentation
case_studies/*
!case_studies/template/
!case_studies/README.md

# R environment and history files
.Rhistory
.RData
.Rproj.user/
*.RData
*.Rhistory

# System and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.agents/
.Rapp.history
Rplots.pdf
